include LICENSE
include NOTICE
include ACKNOWLEDGEMENTS.md
include CITATION.bib
include CITATION.cff
include README.md
recursive-include docs *.md
recursive-include examples *.md *.jsonl
recursive-include configs *.yaml
recursive-include scripts *.sh

prune .venv
prune artifacts
prune activation_shards
prune checkpoints
prune concepts
prune data/private
prune outputs
prune runs
prune wandb

global-exclude *.pdf
global-exclude *.pt
global-exclude *.pth
global-exclude *.bin
global-exclude *.ckpt
global-exclude *.gguf
global-exclude *.h5
global-exclude *.msgpack
global-exclude *.npy
global-exclude *.npz
global-exclude *.onnx
global-exclude *.safetensors
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
